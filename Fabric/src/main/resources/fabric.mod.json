{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_display_name}",
    "description": "${mod_description}",
    "authors": [
      "${mod_authors}"
    ],
    "contact": {
      "homepage": "${mod_homepage}",
      "issues": "${mod_issues_tracker}",
      "sources": "${mod_git_repo}"
    },
    "license": "${mod_license}",
    "icon": "logo.png",
    "environment": "*",
    "entrypoints": {
      "main": [
		"net.tslat.tslatentitystatus.TES"
      ],
      "client": [
		"net.tslat.tslatentitystatus.TESClient"
      ]
    },
    "mixins": [
      "${mod_id}.mixins.json"
    ],
    "accessWidener" : "${mod_id}.classtweaker",
    "depends": {
      "fabricloader": ">=${fabric_loader_version_range}",
      "fabric-api": ">=${fabric_api_version_range}",
      "minecraft": ">=${minecraft_version}",
      "java": ">=${java_version}",
      "forgeconfigapiport": ">=${forgeconfigapiport_version}"
    }
  }
  